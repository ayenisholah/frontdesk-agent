{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}"],
      "project": ["scripts/**", "design/**"]
    },
    "apps/api": {
      "project": ["src/**", "test/**"]
    },
    "apps/worker": {
      "entry": ["src/index.ts", "bin/start.ts"],
      "project": ["src/**", "test/**", "bin/**"]
    },
    "packages/agent": {
      "project": ["src/**", "test/**"]
    },
    "packages/channels": {
      "project": ["src/**", "test/**"]
    },
    "packages/core": {
      "project": ["src/**", "test/**"]
    },
    "packages/db": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**", "test/**", "scripts/**"],
      "ignoreDependencies": ["@prisma/client"]
    },
    "infra": {
      "entry": ["bin/app.ts"],
      "project": ["src/**", "test/**", "bin/**"]
    },
    "packages/runtime": {
      "project": ["src/**", "test/**"]
    }
  }
}
