# Copy to .env for local development. Never commit real values.
PORT=3110
LOG_LEVEL=info
DATABASE_URL=postgresql://frontdesk:frontdesk-local-only@127.0.0.1:5433/frontdesk
REDIS_URL=redis://:frontdesk-local-only@127.0.0.1:6380
# Agent model (Amazon Bedrock). AWS credentials come from the default provider chain; never put keys here.
# AWS_REGION=eu-west-1
# BEDROCK_MODEL_ID=
# BEDROCK_MODEL_ID_SMALL=
# Versioned rates for both model IDs, in microdollars per token. See docs/AGENT_DEVELOPMENT.md.
# BEDROCK_RATES=

# Live provider acceptance is deferred. Keep intake and workers disabled for real traffic.
WHATSAPP_WEBHOOK_ENABLED=false
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Normal worker uses real providers; demo:whatsapp uses explicit fictional adapters.
INBOUND_WORKER_ENABLED=false
OUTBOUND_WORKER_ENABLED=false
CONTENT_RETENTION_ENABLED=false
CONTENT_RETENTION_DAYS=90
QUEUE_PREFIX=frontdesk
WORKER_PORT=3111
