{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "design/**/*.ts",
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/*.config.ts",
    "vitest.config.ts"
  ]
}
